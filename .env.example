# ─── Server ────────────────────────────────────────────────────────────────────
# Port for the Express API server
PORT=3001

# Node environment (development | production | test)
NODE_ENV=development

# ─── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/celebration-planner

# ─── AI ────────────────────────────────────────────────────────────────────────
# Google Gemini API key — NEVER expose this to the client
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Secret key for JWT signing (required in production, min 16 characters)
JWT_SECRET=celebration-planner-dev-secret-key-32chars
JWT_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Frontend origin(s) allowed by the API (comma-separated for multiple)
CORS_ORIGIN=http://localhost:5173

# ─── Client ────────────────────────────────────────────────────────────────────
# Base URL for the API, used by the React app (prefixed with VITE_ so Vite exposes it)
VITE_API_BASE_URL=http://localhost:3001
